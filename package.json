{
  "name": "cubistry-counter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:core && vite --host 0.0.0.0",
    "build": "npm run build:core && vite build",
    "test": "npm run build:core && node --test tests/*.test.mjs",
    "proof": "node research/counter/generate.mjs && python3 research/counter/verify.py",
    "test:proof": "python3 -m unittest discover -s tests -p \"*_test.py\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:proof && python3 research/counter/verify.py && python3 research/architecture/verify_design.py && npm run build",
    "typecheck": "npm run build:core && tsc --noEmit",
    "build:design": "npm run build:core && node research/architecture/build_counter_design.mjs",
    "build:core": "rescript build",
    "test:live-solver": "npm run build:core && node research/m1-acceptance/run-live-solver.mjs /tmp/cubistry-live-solver.json && python3 research/m1-acceptance/verify_live_solver.py /tmp/cubistry-live-solver.json",
    "test:pages": "playwright test --config playwright.pages.config.mjs"
  },
  "dependencies": {
    "@cubistry/cube-assets": "*",
    "@cubistry/cube-core": "*",
    "@cubistry/cube-mechanics": "*",
    "@cubistry/cube-viewer": "*",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "5.2.10",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/three": "0.180.0",
    "cubing": "0.66.1",
    "pngjs": "7.0.0",
    "rescript": "12.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  }
}
