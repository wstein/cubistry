{
  "name": "cubistry-counter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "proof": "node research/counter/generate.mjs && python3 research/counter/verify.py",
    "test:proof": "python3 -m unittest discover -s tests -p \"*_test.py\"",
    "test:e2e": "playwright test",
    "check": "npm test && npm run test:proof && python3 research/counter/verify.py && npm run build"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "cubing": "0.66.1",
    "pngjs": "7.0.0",
    "vite": "7.1.12",
    "@fontsource/noto-sans": "5.2.10"
  }
}
