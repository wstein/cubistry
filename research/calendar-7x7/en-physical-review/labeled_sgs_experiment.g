Read("research/calendar-7x7/en-physical-review/action.g");;
Read("research/calendar-7x7/en-physical-review/known_order.g");;
Read("research/calendar-7x7/en-physical-review/front_base.g");;
labels := StraightLineProgGens(gens);;
H := Group(labels);;
map := GroupGeneralMappingByImages(G,H,gens,labels);;
SetIsTotal(map,true);;
Print("known_order_digits\t",Length(String(Size(G))),"\n");
t := Runtime();;
S := StabChainMutable(map,rec(base:=fullbase));;
Print("labeled_sgs_ms\t",Runtime()-t,"\n");
p := gens[1]*gens[2]*gens[3];;
t := Runtime();;
word := ImageSiftedBaseImage(S,OnTuples(BaseStabChain(S),p),S.idimage,OnRight)^-1;;
Print("word_is_slp\t",IsStraightLineProgElm(word),"\n");
Print("word_correct\t",EvalStraightLineProgElm(word)=p,"\n");
Print("word_lines\t",Length(LinesOfStraightLineProgram(word![2])),"\n");
Print("word_ms\t",Runtime()-t,"\n");
SaveWorkspace("/workspace/shared/calendar-tooling/calendar7-labeled-group.ws");
Print("workspace_saved\n");
QUIT;
