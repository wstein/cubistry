    "build": "npm run generate && tsc",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "antlr4ng": "3.0.16"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "antlr-ng": "1.0.10",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
